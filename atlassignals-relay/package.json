{
  "name": "atlassignals-relay",
  "version": "0.1.0",
  "private": true,
  "description": "AtlasSignals Relay — the source-of-truth backend for trading signals produced by the Hugging Face analysis engine.",
  "keywords": ["trading", "signals", "webhook", "fastify", "supabase"],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "pino": "^9.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@vercel/node": "^3.2.0",
    "pino-pretty": "^11.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^3.0.0"
  }
}
