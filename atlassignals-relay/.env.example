[TEMPLATE]
# ─── AtlasSignals Relay — environment variables ──────────────────────────────
# Copy this file to .env and fill in real values. NEVER commit .env.

# Server
PORT=3000
NODE_ENV=production

# Supabase (Postgres). The backend uses the SERVICE ROLE key for persistence.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared HMAC secret — MUST be identical to WEBHOOK_SECRET in the Hugging Face
# Space. Used to verify the x-atlas-signature header on every signal webhook.
WEBHOOK_SECRET=

# ── Paystack (payment lifecycle) ─────────────────────────────────────────────
# Secret key: used to verify webhook signatures (HMAC-SHA512) AND to call the
# Paystack API. Without it, /payments/initialize and /webhooks/paystack answer
# 503. Get it from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
# Public key — for the frontend (Paystack Inline checkout) if used.
PAYSTACK_PUBLIC_KEY=
# Monthly plan price in MINOR units (kobo for NGN), e.g. 500000 = ₦5,000.
# Required to enable POST /payments/initialize.
PAYSTACK_PLAN_AMOUNT=
PAYSTACK_CURRENCY=NGN
PAYSTACK_PLAN_NAME=AtlasSignals Monthly

# Telegram multi-user delivery (pg_net trigger fans out to linked users).
# TELEGRAM_CHAT_ID is the fallback/operator chat used when no user is linked.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Secret token passed to Telegram's setWebhook; the backend rejects bot
# webhook calls that don't carry it (X-Telegram-Bot-Api-Secret-Token).
TELEGRAM_WEBHOOK_SECRET=

# Real-time dashboard stream. Keep enabled on long-running hosts (Railway /
# Render / Fly.io). Set to false on Vercel serverless (no streaming).
SSE_ENABLED=true
