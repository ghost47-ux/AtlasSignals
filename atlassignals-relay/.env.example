# ─── AtlasSignals Relay — environment variables ──────────────────────────────
# Copy this file to .env and fill in real values. NEVER commit .env.

# Server
PORT=3000
NODE_ENV=production

# Supabase (Postgres). The backend uses the SERVICE ROLE key for persistence.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared HMAC secret — MUST be identical to WEBHOOK_SECRET in the Hugging Face
# Space. Used to verify the x-atlas-signature header on every webhook call.
WEBHOOK_SECRET=

# Telegram delivery (outbox jobs are created now; actual sending is a
# placeholder until the delivery worker is implemented).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Real-time dashboard stream. Keep enabled on long-running hosts (Railway /
# Render / Fly.io). Set to false on Vercel serverless (no streaming).
SSE_ENABLED=true
